{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git push*)",
      "Bash(./scripts/run.sh *)",
      "Bash(./scripts/lint.sh *)"
    ],
    "deny": [
      "Bash(git push* --force*)",
      "Bash(git push* +*)",
      "Bash(git push* -f*)",
      "Bash(git push* -uf*)",
      "Bash(git push* -vf*)",
      "Bash(git push* -qf*)",
      "Bash(git push* -nf*)",
      "Bash(git push* -df*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(rm -R -f*)",
      "Bash(rm -f -R*)",
      "Bash(rm --recursive*)"
    ]
  }
}
